{
	"name": "adb-sql-formatter",
	"displayName": "ADB SQL Formatter",
	"description": "ADB / AnalyticDB MySQL flavored SQL formatter for VS Code: lowercase keywords, leading commas, tab indent, DataGrip-style clause breaks, one option per line in CREATE TABLE, ${bizdate} aware. Formats on save.",
	"version": "1.5.0",
	"publisher": "YipTszkwan",
	"license": "MIT",
	"icon": "images/icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/MiseHinoha/adb-sql-formatter.git"
	},
	"homepage": "https://github.com/MiseHinoha/adb-sql-formatter#readme",
	"engines": {
		"vscode": "^1.70.0"
	},
	"categories": [
		"Formatters",
		"Programming Languages"
	],
	"activationEvents": [
		"onCommand:adbSqlFormatter.formatDocument",
		"onLanguage:sql",
		"onLanguage:mysql",
		"onCommand:adbSqlFormatter.formatAndSave"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "adbSqlFormatter.formatDocument",
				"title": "%adbSqlFormatter.command.formatDocument%"
			},
			{
				"command": "adbSqlFormatter.formatAndSave",
				"title": "%adbSqlFormatter.command.formatAndSave%"
			}
		],
		"keybindings": [
			{
				"command": "adbSqlFormatter.formatAndSave",
				"key": "ctrl+s",
				"mac": "cmd+s",
				"when": "adbSqlFormatter.takeOverSaveKey && editorTextFocus && !editorReadonly && editorLangId == sql"
			},
			{
				"command": "adbSqlFormatter.formatAndSave",
				"key": "ctrl+s",
				"mac": "cmd+s",
				"when": "adbSqlFormatter.takeOverSaveKey && editorTextFocus && !editorReadonly && editorLangId == mysql"
			}
		],
		"configuration": {
			"title": "ADB SQL Formatter",
			"properties": {
				"adbSqlFormatter.keywordCase": {
					"type": "string",
					"enum": [
						"lower",
						"upper",
						"preserve"
					],
					"default": "lower",
					"description": "%adbSqlFormatter.keywordCase%"
				},
				"adbSqlFormatter.expressionWidth": {
					"type": "number",
					"default": 100,
					"description": "%adbSqlFormatter.expressionWidth%"
				},
				"adbSqlFormatter.logicalOperatorNewline": {
					"type": "string",
					"enum": [
						"before",
						"after"
					],
					"default": "before",
					"description": "%adbSqlFormatter.logicalOperatorNewline%"
				},
				"adbSqlFormatter.linesBetweenQueries": {
					"type": "number",
					"default": 1,
					"description": "%adbSqlFormatter.linesBetweenQueries%"
				},
				"adbSqlFormatter.requireSemicolonBetweenStatements": {
					"type": "boolean",
					"default": true,
					"description": "%adbSqlFormatter.requireSemicolonBetweenStatements%"
				},
				"adbSqlFormatter.missingSemicolonSeverity": {
					"type": "string",
					"enum": [
						"warning",
						"error"
					],
					"default": "warning",
					"description": "%adbSqlFormatter.missingSemicolonSeverity%"
				},
				"adbSqlFormatter.formatOnSave": {
					"type": "boolean",
					"default": false,
					"description": "%adbSqlFormatter.formatOnSave%"
				},
				"adbSqlFormatter.takeOverSaveKey": {
					"type": "boolean",
					"default": true,
					"description": "%adbSqlFormatter.takeOverSaveKey%"
				}
			}
		},
		"menus": {
			"editor/context": [
				{
					"command": "adbSqlFormatter.formatDocument",
					"when": "editorLangId == sql || editorLangId == mysql",
					"group": "1_modification@9"
				}
			]
		}
	},
	"dependencies": {
		"sql-formatter": "^13.1.0"
	},
	"scripts": {
		"test": "node test-selfcheck.js && node test-semi-detect.js && node test-extension.js",
		"test:real": "node check-ddl.js",
		"test:ab": "node ab-format.js",
		"test:semi-scan": "node scan-semicolon.js",
		"package": "mkdir -p dist && npx --yes @vscode/vsce package --out dist/"
	},
	"keywords": [
		"sql",
		"formatter",
		"adb",
		"analyticdb",
		"mysql",
		"dataworks",
		"leading-comma"
	],
	"bugs": {
		"url": "https://github.com/MiseHinoha/adb-sql-formatter/issues"
	}
}
